{
	// The engine install path is hard-coded in tasks.json and Wind.code-workspace.
	// To switch machines, copy local.config.example -> local.config, fill in your
	// local paths, and run Tools\setup-vscode.ps1. See local.config.example for details.
	// Treat UE build/descriptor scripts as their host language instead of plain text.
	"files.associations": {
		"*.Build.cs": "csharp",
		"*.Target.cs": "csharp",
		"*.uproject": "json",
		"*.uplugin": "json"
	},

	// Keep generated output out of search results and file watching.
	"search.exclude": {
		"**/Binaries/**": true,
		"**/DerivedDataCache/**": true,
		"**/Intermediate/**": true,
		"**/Saved/**": true,
		"**/.vscode/compileCommands_*/**": true
	},
	"files.watcherExclude": {
		"**/Binaries/**": true,
		"**/DerivedDataCache/**": true,
		"**/Intermediate/**": true,
		"**/Saved/**": true
	}
}

// WindFieldCommon.ush — Shared types and utility functions for the wind field system.
// Included by the compute shader and the material sampling function.

#pragma once

// ============================================================================
// GPU wind source structure — must match C++ FGPUWindSourceData exactly (64 bytes)
// ============================================================================
struct FGPUWindSource
{
	float3 Position;          // 12 bytes  offset 0
	float  Strength;          //  4 bytes  offset 12
	float3 Direction;         // 12 bytes  offset 16
	float  Radius;            //  4 bytes  offset 28
	float  InnerRadius;       //  4 bytes  offset 32
	float  FalloffExponent;   //  4 bytes  offset 36
	uint   WindType;          //  4 bytes  offset 40
	float  HalfHeight;        //  4 bytes  offset 44
	float  EndRadius;         //  4 bytes  offset 48
	float  NoiseStrength;     //  4 bytes  offset 52
	float  Padding3;    //  4 bytes  offset 56
	float  Padding;           //  4 bytes  offset 60
};

// Wind type constants
#define WIND_TYPE_DIRECTIONAL 0
#define WIND_TYPE_POINT       1
#define WIND_TYPE_VORTEX      2
#define WIND_TYPE_CYLINDER    3
#define WIND_TYPE_CAPSULE_INTERACTIVE 4

// ============================================================================
// Per-source wind contribution functions
// ============================================================================

/** Directional (global) wind */
float3 ComputeDirectionalWind(FGPUWindSource Source, float3 WorldPos, float Time)
{
	return Source.Direction * Source.Strength;
}

/** Point (radial) wind — pushes outward from source position */
float3 ComputePointWind(FGPUWindSource Source, float3 WorldPos, float Time)
{
	float3 Delta = WorldPos - Source.Position;
	float Distance = length(Delta);

	if (Distance > Source.Radius || Distance < 0.001)
		return float3(0, 0, 0);

	float3 Dir = Delta / Distance;

	// Compute distance-based falloff
	float NormalizedDist = 0;
	float RadiusRange = Source.Radius - Source.InnerRadius;
	if (RadiusRange > 0)
	{
		NormalizedDist = saturate((Distance - Source.InnerRadius) / RadiusRange);
	}
	float Attenuation = pow(1.0 - NormalizedDist, Source.FalloffExponent);

	return Dir * Source.Strength * Attenuation;
}

/** Vortex (rotational) wind — swirls around vertical axis at source position */
float3 ComputeVortexWind(FGPUWindSource Source, float3 WorldPos, float Time)
{
	float3 Delta = WorldPos - Source.Position;
	float HorizDist = length(Delta.xy);
	float Distance = length(Delta);

	if (HorizDist > Source.Radius || HorizDist < 0.001)
		return float3(0, 0, 0);

	// Tangential direction (perpendicular to radius in XY plane)
	float3 Tangent = float3(-Delta.y, Delta.x, 0) / HorizDist;
	
	// Outer falloff
	float NormalizedDist = 0;
	float RadiusRange = Source.Radius - Source.InnerRadius;
	if (RadiusRange > 0)
	{
		NormalizedDist = saturate((Distance - Source.InnerRadius) / RadiusRange);
	}
	float OuterFade = pow(1.0 - NormalizedDist, Source.FalloffExponent);

	// Inner dead zone fade-in
	float InnerFade = saturate(HorizDist / max(Source.InnerRadius, 1.0));

	return Tangent * Source.Strength * OuterFade * InnerFade;
}

/** Cylinder / Cone wind — pushes along axis within a tapered tube.
 *  Radius = base radius (−Direction end), EndRadius = top radius (+Direction end).
 *  When EndRadius == 0 the shape degenerates to a cone. */
float3 ComputeCylinderWind(FGPUWindSource Source, float3 WorldPos, float Time)
{
	float3 Delta = WorldPos - Source.Position;
	float3 Axis  = Source.Direction; // normalized forward

	// Project onto axis: signed distance from center
	float AxisDist = dot(Delta, Axis);
	float HH = Source.HalfHeight;

	// Outside height range?
	if (abs(AxisDist) > HH)
		return float3(0, 0, 0);

	// t ∈ [0,1]: 0 = base (−Dir), 1 = top (+Dir)
	float t = (AxisDist + HH) / (2.0 * HH);

	// Interpolated radius at this height slice
	float LocalRadius = lerp(Source.Radius, Source.EndRadius, t);

	// Radial vector (perpendicular to axis)
	float3 RadialVec = Delta - Axis * AxisDist;
	float  RadialDist = length(RadialVec);

	if (RadialDist > LocalRadius)
		return float3(0, 0, 0);

	float3 OutDir = normalize(Axis * 2.0 * HH + (Source.EndRadius - Source.Radius)* normalize(RadialVec));
	float3 WindDir = lerp(Axis, OutDir, saturate((RadialDist - Source.InnerRadius) / max(LocalRadius - Source.InnerRadius, 0.001)));

	// Radial falloff (inner → outer)
	float RadialAtten = 1.0;
	float InnerR = min(Source.InnerRadius, LocalRadius);
	if (LocalRadius > InnerR)
	{
		float NormDist = saturate((RadialDist - InnerR) / (LocalRadius - InnerR));
		RadialAtten = pow(max(0.00001, 1.0 - NormDist), Source.FalloffExponent);
	}

	// Axial edge fade (smooth near caps)
	float EdgeFade = 1.0 - smoothstep(0.85, 1.0, abs(AxisDist) / HH);

	return WindDir * Source.Strength * RadialAtten * EdgeFade;
}

/** Capsule interactive wind driven by transform motion.
 *  Payload mapping for this type:
 *  - linear velocity: (Strength, InnerRadius, FalloffExponent)
 *  - angular velocity: (EndRadius, NoiseStrength, Padding3)
 *  - influence falloff exponent: Padding
 */
float3 ComputeCapsuleInteractiveWind(FGPUWindSource Source, float3 WorldPos, float Time)
{
	float3 Axis = normalize(Source.Direction);
	float Radius = max(Source.Radius, 1.0);
	float HalfHeight = max(Source.HalfHeight, Radius);
	float SegmentHalfLen = max(HalfHeight - Radius, 0.0);

	float3 Delta = WorldPos - Source.Position;
	float AxisT = clamp(dot(Delta, Axis), -SegmentHalfLen, SegmentHalfLen);
	float3 Closest = Source.Position + Axis * AxisT;
	float3 Radial = WorldPos - Closest;
	float Dist = length(Radial);

	if (Dist > Radius)
		return float3(0, 0, 0);

	float FalloffExponent = max(Source.Padding, 0.001);
	float Atten = pow(saturate(1.0 - Dist / Radius), FalloffExponent);

	float3 LinearVelocity = float3(Source.Strength, Source.InnerRadius, Source.FalloffExponent);
	float3 AngularVelocity = float3(Source.EndRadius, Source.NoiseStrength, Source.Padding3);
	float3 Relative = WorldPos - Source.Position;
	float3 LocalVelocity = LinearVelocity + cross(AngularVelocity, Relative);

	return LocalVelocity * Atten;
}

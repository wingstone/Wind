//
// WindFieldCompute.usf — Compute shader for fluid-based 3D wind field simulation.
//
// Uses operator splitting into two passes:
//   Pass 0 (Advection):  Semi-Lagrangian backtrace + external force injection
//   Pass 1 (Diffusion):  Jacobi iteration of the Laplacian on the advected field
//
// Dispatch: (ResolutionX/8, ResolutionY/8, ResolutionZ/8) thread groups
// Each thread computes one texel of the 3D wind field volume.
// Output: float4(WindVelocity.xyz, Turbulence)

#include "/Engine/Private/Common.ush"
#include "WindFieldCommon.ush"

// ============================================================================
// Shader parameters (bound from C++ via FWindFieldComputeCS::FParameters)
// ============================================================================

// Volume parameters
float3 FieldOrigin;    // World-space origin (minimum corner) of the wind field
float  Time;           // World time in seconds
float3 FieldExtent;    // World-space size of the wind field volume
uint   SourceCount;    // Number of active wind sources
uint   ResolutionX;    // Texel count X
uint   ResolutionY;    // Texel count Y
uint   ResolutionZ;    // Texel count Z
float  Padding0;

// Fluid simulation parameters
float  DeltaTime;       // Frame delta time
float  Viscosity;       // Diffusion coefficient (higher = smoother, more viscous)
float3 PrevFieldOrigin; // Previous frame's wind field origin for advection
float  Dissipation;     // Energy dissipation per frame (0.9 = fast decay, 1.0 = no decay)

// Wind source data (Pass 0 only)
StructuredBuffer<FGPUWindSource> WindSources;

// Input field (previous frame for Pass 0, advected result for Pass 1)
Texture3D<float4> InputField;
SamplerState InputFieldSampler;

// Output 3D wind field texture
RWTexture3D<float4> WindFieldOutput;

// Directional wind noise texture (spatial modulation)
Texture2D DirectionalNoiseTexture;
SamplerState DirectionalNoiseSampler;
float3 DirNoiseWindDirection;
float  DirNoiseTiling;
float  DirNoiseIntensityMin;
float  DirNoiseIntensityMax;
float  DirNoiseScrollSpeed;
uint   bHasDirectionalNoise;

// ============================================================================
// Pass selection via permutation
// ============================================================================

#ifndef THREADGROUP_SIZE
#define THREADGROUP_SIZE 8
#endif

// PASS_TYPE is set by the C++ permutation:
//   0 = Advection + Source Injection
//   1 = Diffusion (Jacobi Laplacian)

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, THREADGROUP_SIZE)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	// Bounds check
	if (DispatchThreadId.x >= ResolutionX ||
	    DispatchThreadId.y >= ResolutionY ||
	    DispatchThreadId.z >= ResolutionZ)
	{
		return;
	}

	float3 Resolution = float3(ResolutionX, ResolutionY, ResolutionZ);
	float3 UVW = (float3(DispatchThreadId) + 0.5) / Resolution;
	float3 WorldPos = FieldOrigin + UVW * FieldExtent;

#if PASS_TYPE == 0
	// ====================================================================
	// Pass 0: Advection (对流项) + External Force Injection
	//
	// Semi-Lagrangian: trace backwards along previous velocity field,
	// then inject source forces. Unconditionally stable.
	// ====================================================================

	float4 Advected = float4(0, 0, 0, 0);

	if (DeltaTime > 0.0)
	{
		// Sample previous velocity at current position
		float3 PrevUVW = saturate((WorldPos - PrevFieldOrigin) / max(FieldExtent, 0.001));
		float3 PrevVelocity = InputField.SampleLevel(InputFieldSampler, PrevUVW, 0).xyz;

		// Backtrace: find the position this fluid element came from
		float3 BacktracePos = WorldPos - PrevVelocity * DeltaTime;
		float3 BacktraceUVW = saturate((BacktracePos - PrevFieldOrigin) / max(FieldExtent, 0.001));

		// Sample the advected velocity (trilinear interpolation)
		Advected = InputField.SampleLevel(InputFieldSampler, BacktraceUVW, 0);

		// Apply dissipation to advected field
		Advected *= Dissipation;
	}

	// Accumulate external forces from wind sources
	float3 TotalForce = float3(0, 0, 0);
	float  TotalTurbulence = 0;

	for (uint i = 0; i < SourceCount; i++)
	{
		FGPUWindSource Source = WindSources[i];
		float3 WindContribution = float3(0, 0, 0);

		if (Source.WindType == WIND_TYPE_DIRECTIONAL)
		{
			WindContribution = ComputeDirectionalWind(Source, WorldPos, Time);

			// Modulate directional wind by noise texture (spatial variation)
			if (bHasDirectionalNoise > 0)
			{
				// Project world position onto XY plane for noise UV lookup
				// Scroll along wind direction over time
				float2 NoiseUV = WorldPos.xy * DirNoiseTiling * 0.0001
				               + DirNoiseWindDirection.xy * DirNoiseScrollSpeed * Time * 0.0001;
				float NoiseSample = DirectionalNoiseTexture.SampleLevel(DirectionalNoiseSampler, NoiseUV, 0).r;
				float Modulation = lerp(DirNoiseIntensityMin, DirNoiseIntensityMax, NoiseSample);
				WindContribution *= Modulation;
			}
		}
		else if (Source.WindType == WIND_TYPE_POINT)
		{
			WindContribution = ComputePointWind(Source, WorldPos, Time);
		}
		else if (Source.WindType == WIND_TYPE_VORTEX)
		{
			WindContribution = ComputeVortexWind(Source, WorldPos, Time);
		}

		// FBM curl-noise turbulence per source
		if (Source.NoiseStrength > 0)
		{
			float3 NoisePos = WorldPos * Source.NoiseFrequency * 0.01 + Time * 0.5;
			float3 NoiseTurbulence = CurlNoiseFBM(NoisePos, 3) * Source.NoiseStrength;
			float WindMag = length(WindContribution);
			WindContribution += NoiseTurbulence * max(WindMag, 1.0);
			TotalTurbulence += Source.NoiseStrength * WindMag;
		}

		TotalForce += WindContribution;
	}

	// Combine: advected field + source injection
	// InjectionRate = (1 - Dissipation) so at steady state u = F
	float InjectionRate = 1.0 - Dissipation;
	float4 Result;

	if (DeltaTime > 0.0)
	{
		Result.xyz = Advected.xyz + InjectionRate * TotalForce;
		Result.w   = Advected.w   + InjectionRate * TotalTurbulence;
	}
	else
	{
		// First frame — use direct source velocity
		Result = float4(TotalForce, TotalTurbulence);
	}

	WindFieldOutput[DispatchThreadId] = Result;

#else // PASS_TYPE == 1
	// ====================================================================
	// Pass 1: Diffusion (扩散项)
	//
	// Jacobi iteration of the viscous diffusion equation:
	//   (I - ν·Δt·∇²) u_new = u_advected
	//
	// Rearranged for Jacobi solving:
	//   u_new = (u_advected + α·Σ neighbors) / (6α + 1)
	//   where α = ν·Δt / h²
	//
	// InputField here is the output of Pass 0 (advected field).
	// ====================================================================

	float3 TexelSize = 1.0 / Resolution;

	// Compute cell spacing in world units (h)
	float3 CellSize = FieldExtent / Resolution;
	float h2 = dot(CellSize, CellSize) / 3.0; // average h²

	float Alpha = Viscosity * DeltaTime / max(h2, 1e-6);

	// Sample the advected field: center + 6 neighbors
	float4 Center = InputField.SampleLevel(InputFieldSampler, UVW, 0);
	float4 Lxp = InputField.SampleLevel(InputFieldSampler, UVW + float3(TexelSize.x, 0, 0), 0);
	float4 Lxn = InputField.SampleLevel(InputFieldSampler, UVW - float3(TexelSize.x, 0, 0), 0);
	float4 Lyp = InputField.SampleLevel(InputFieldSampler, UVW + float3(0, TexelSize.y, 0), 0);
	float4 Lyn = InputField.SampleLevel(InputFieldSampler, UVW - float3(0, TexelSize.y, 0), 0);
	float4 Lzp = InputField.SampleLevel(InputFieldSampler, UVW + float3(0, 0, TexelSize.z), 0);
	float4 Lzn = InputField.SampleLevel(InputFieldSampler, UVW - float3(0, 0, TexelSize.z), 0);

	// Jacobi: u_new = (u_center + α·Σ neighbors) / (1 + 6α)
	float4 NeighborSum = Lxp + Lxn + Lyp + Lyn + Lzp + Lzn;
	float4 Result = (Center + Alpha * NeighborSum) / (1.0 + 6.0 * Alpha);

	WindFieldOutput[DispatchThreadId] = Result;

#endif // PASS_TYPE
}

/*=============================================================================
	ShallowWaterSolver.usf: 2D Shallow Water Equations Solver
	
	Solves the shallow water equations using finite difference method:
	∂h/∂t + ∂(hu)/∂x + ∂(hv)/∂y = 0  (continuity)
	∂u/∂t + u∂u/∂x + v∂u/∂y = -g∂h/∂x + ν∇²u - ku  (x-momentum)
	∂v/∂t + u∂v/∂x + v∂v/∂y = -g∂h/∂y + ν∇²v - kv  (y-momentum)
	
	where:
	h = water height
	u, v = velocity components
	g = gravity
	ν = viscosity
	k = damping/friction
=============================================================================*/

#include "/Engine/Private/Common.ush"

#if !defined(THREAD_GROUP_SIZE)
#define THREAD_GROUP_SIZE 16
#endif

uint GridSize;
float CellSize;
float2 GridOrigin;
float DeltaTime;
SamplerState LinearSampler;
Texture2D CurrentHeightField;
RWTexture2D<float> NextHeightField;
Texture2D CurrentVelocityField;
RWTexture2D<float2> NextVelocityField;

// Sample height field with boundary conditions
float SampleHeight(int2 Coord)
{
	return CurrentHeightField[Coord].x;
}

// Sample velocity field with boundary conditions
float2 SampleVelocity(int2 Coord)
{
	return CurrentVelocityField[Coord].xy;
}

float2 GridToWorld(int2 Coord)
{
	return Coord * CellSize + GridOrigin;
}

float2 WorldToUV(float2 WorldPos)
{
	float2 GridSizeInv = 1.0f / GridSize;
	return (WorldPos - GridOrigin) / (CellSize * GridSize) + GridSizeInv * 0.5;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void HeightAdvectionCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);
	
	// Boundary check
	if (Coord.x >= GridSize || Coord.y >= GridSize)
		return;
	
	// Current state
	float h = SampleHeight(Coord);
	float2 vel = SampleVelocity(Coord);
	
	// UV of current cell center
	float2 UV = (float2(Coord) + 0.5) / float(GridSize);
	
	// Trace backwards in time (convert world velocity to UV displacement)
	float WorldSize = CellSize * float(GridSize);
	float2 BackUV = UV - vel * DeltaTime / WorldSize;
	
	// Sample height at back-traced position
	float newHeight = Texture2DSampleLevel(CurrentHeightField, LinearSampler, BackUV, 0).x;
	
	// Write output
	NextHeightField[Coord] = newHeight;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void VelocityAdvectionCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);
	
	// Boundary check
	if (Coord.x >= GridSize || Coord.y >= GridSize)
		return;
	
	// Current state
	float2 vel = SampleVelocity(Coord);
	
	// UV of current cell center
	float2 UV = (float2(Coord) + 0.5) / float(GridSize);
	
	// Trace backwards in time (convert world velocity to UV displacement)
	float WorldSize = CellSize * float(GridSize);
	float2 BackUV = UV - vel * DeltaTime / WorldSize;

	// Sample velocity at back-traced position
	float2 newVel = Texture2DSampleLevel(CurrentVelocityField, LinearSampler, BackUV, 0).xy;
	
	// Write output
	NextVelocityField[Coord] = newVel;
}

Texture2D PrevHeightField;
float Alpha;
float Beta;
float Damping;

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void DiffusionCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);
	
	// Boundary check
	if (Coord.x >= GridSize || Coord.y >= GridSize)
		return;
	
	// Current state
	float h = SampleHeight(Coord);
	float up_h = SampleHeight(Coord + int2(0, 1));
	float down_h = SampleHeight(Coord + int2(0, -1));
	float left_h = SampleHeight(Coord + int2(-1, 0));
	float right_h = SampleHeight(Coord + int2(1, 0));

	float prev_h = PrevHeightField[Coord].x;

	float newHeight = Damping* ( h + Beta * (h - prev_h) + Alpha * (up_h + down_h + left_h + right_h - 4.0 * h));
	
	// Write output
	NextHeightField[Coord] = newHeight;
}

Texture2D HeightField;
RWTexture2D<float2> OutNormalField;

float SampleNormalHeight(int2 Coord)
{
	int2 ClampedCoord = clamp(Coord, int2(0, 0), int2(GridSize - 1, GridSize - 1));
	return HeightField[ClampedCoord].x;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void HeightToNormalCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);

	if (Coord.x >= GridSize || Coord.y >= GridSize)
		return;

	float HeightLeft = SampleNormalHeight(Coord + int2(-1, 0));
	float HeightRight = SampleNormalHeight(Coord + int2(1, 0));
	float HeightDown = SampleNormalHeight(Coord + int2(0, -1));
	float HeightUp = SampleNormalHeight(Coord + int2(0, 1));

	float Dhdx = (HeightRight - HeightLeft) / (2.0 * CellSize);
	float Dhdy = (HeightUp - HeightDown) / (2.0 * CellSize);

	float3 NormalWS = normalize(float3(-Dhdx, -Dhdy, 1.0));
	OutNormalField[Coord] = NormalWS.xy;
}

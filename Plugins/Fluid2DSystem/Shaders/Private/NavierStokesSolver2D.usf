/*=============================================================================
	NavierStokesSolver2D.usf: 2D Incompressible Navier-Stokes Equations Solver
	
	Solves the incompressible Navier-Stokes equations in 2D:
	∂u/∂t + (u·∇)u = -1/ρ ∇p + ν∇²u + f  (momentum equation)
	∇·u = 0                                 (incompressibility constraint)
	
	Method: Projection Method (Chorin's method)
	Step 1: Advection  - Semi-Lagrangian transport of velocity
	Step 2: Diffusion  - Apply viscosity (explicit Laplacian)
	Step 3: Divergence - Compute velocity divergence
	Step 4: Pressure   - Jacobi iteration for Poisson equation
	Step 5: Projection - Subtract pressure gradient for incompressibility
=============================================================================*/

#include "/Engine/Private/Common.ush"

#if !defined(THREAD_GROUP_SIZE)
#define THREAD_GROUP_SIZE 16
#endif

// Simulation parameters (bound per-pass via parameter struct)
int GridSize;
float DeltaTime;
float CellSize;
float Density;
float Viscosity;
float Damping;

// Texture inputs (SRV)
Texture2D VelocityField;
Texture2D OriginalVelocityField;
Texture2D PressureField;
Texture2D DivergenceField;
Texture2D DensityField;
Texture2D OriginalDensityField;
Texture2D VorticityField;
SamplerState LinearSampler;

// Global flow noise
float FlowNoiseIntensityMin;
float FlowNoiseIntensityMax;
float FlowNoiseTiling;
float2 FlowDirection;
float4 UVScaleOffset;
SamplerState FlowNoiseSampler;
Texture2D FlowNoiseTexture;

// Vorticity confinement
float VorticityEpsilon;

// Texture outputs (UAV)
RWTexture2D<float2> OutVelocityField;
RWTexture2D<float> OutPressureField;
RWTexture2D<float> OutDivergenceField;
RWTexture2D<float> OutDensityField;
RWTexture2D<float> OutVorticityField;

// Load velocity with boundary clamping
float2 LoadVelocity(int2 Coord)
{
	Coord = clamp(Coord, int2(0, 0), int2(GridSize - 1, GridSize - 1));
	return VelocityField.Load(int3(Coord, 0)).xy;
}

float LoadDensity(int2 Coord)
{
	Coord = clamp(Coord, int2(0, 0), int2(GridSize - 1, GridSize - 1));
	return DensityField.Load(int3(Coord, 0)).x;
}

// Load pressure with boundary clamping
float LoadPressure(int2 Coord)
{
	Coord = clamp(Coord, int2(0, 0), int2(GridSize - 1, GridSize - 1));
	return PressureField.Load(int3(Coord, 0)).x;
}

//=============================================================================
// Global flow noise helper
//=============================================================================
float2 GetGlobalFlowVelocity(int2 Coord)
{
	float2 UV = (float2(Coord) + 0.5) / float(GridSize);
	float2 GlobalFlowUV = UV * UVScaleOffset.xy + UVScaleOffset.zw;
	float2 NoiseUV = GlobalFlowUV * FlowNoiseTiling;
	float NoiseSample = FlowNoiseTexture.SampleLevel(FlowNoiseSampler, NoiseUV, 0).r;
	return FlowDirection * lerp(FlowNoiseIntensityMin, FlowNoiseIntensityMax, NoiseSample);
}

//=============================================================================
// Step 1: Advection (Semi-Lagrangian with bilinear sampling)
//=============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void AdvectionCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);

	if (any(Coord >= GridSize))
		return;

	float2 Vel = LoadVelocity(Coord);

	// Add global flow noise contribution
	Vel += GetGlobalFlowVelocity(Coord);

	// UV of current cell center
	float2 UV = (float2(Coord) + 0.5) / float(GridSize);

	// Trace backwards in time (convert world velocity to UV displacement)
	float WorldSize = CellSize * float(GridSize);
	float2 BackUV = UV - Vel * DeltaTime / WorldSize;

	// Bilinear sample at back-traced position
	float2 NewVel = VelocityField.SampleLevel(LinearSampler, BackUV, 0).xy;
	float NewDensity = DensityField.SampleLevel(LinearSampler, BackUV, 0).x;

	// Apply damping
	NewVel *= Damping;
	NewDensity *= Damping;

	OutVelocityField[Coord] = NewVel;
	OutDensityField[Coord] = NewDensity;
}

//=============================================================================
// Step 2: Diffusion (Implicit viscosity via Jacobi iteration)
//   Solves (I - ν·Δt·∇²) u^{n+1} = u^n  using Jacobi relaxation:
//   u^{k+1}_{i,j} = (u^n_{i,j}·α + (u^k neighbors)) / (1 + 4α)
//   where α = h² / ν·Δt
//=============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void DiffusionCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);

	if (any(Coord >= GridSize))
		return;

	// Boundary: zero velocity at edges
	if (Coord.x == 0 || Coord.x == GridSize - 1 || Coord.y == 0 || Coord.y == GridSize - 1)
	{
		OutVelocityField[Coord] = float2(0, 0);
		return;
	}

	float Alpha = (CellSize * CellSize) / (Viscosity * DeltaTime);
	float InvBeta = 1.0 / (4.0 + Alpha);

	// Original velocity from advection step (constant source term)
	float2 Original = OriginalVelocityField.Load(int3(Coord, 0)).xy;

	// Neighbors from previous Jacobi iteration
	float2 Left  = LoadVelocity(Coord + int2(-1, 0));
	float2 Right = LoadVelocity(Coord + int2(1, 0));
	float2 Up    = LoadVelocity(Coord + int2(0, 1));
	float2 Down  = LoadVelocity(Coord + int2(0, -1));
	float2 NewVel = (Original * Alpha + (Left + Right + Up + Down)) * InvBeta;

	// Original density from advection step (constant source term)
	float OriginDensity = OriginalDensityField.Load(int3(Coord, 0)).x;

	// Neighbors from previous Jacobi iteration
	float LeftDensity  = LoadDensity(Coord + int2(-1, 0));
	float RightDensity = LoadDensity(Coord + int2(1, 0));
	float UpDensity    = LoadDensity(Coord + int2(0, 1));
	float DownDensity  = LoadDensity(Coord + int2(0, -1));
	float NewDensity = (OriginDensity * Alpha + (LeftDensity + RightDensity + UpDensity + DownDensity)) * InvBeta;

	OutVelocityField[Coord] = NewVel;
	OutDensityField[Coord] = NewDensity;
}

//=============================================================================
// Step 3: Compute Divergence (∇·u)
//=============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ComputeDivergenceCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);

	if (any(Coord >= GridSize))
		return;

	float2 Right = LoadVelocity(Coord + int2(1, 0));
	float2 Left  = LoadVelocity(Coord + int2(-1, 0));
	float2 Up    = LoadVelocity(Coord + int2(0, 1));
	float2 Down  = LoadVelocity(Coord + int2(0, -1));

	float Div = (Right.x - Left.x + Down.y - Up.y) / (2.0 * CellSize);

	OutDivergenceField[Coord] = Div;
}

//=============================================================================
// Step 4: Pressure Solve (Jacobi iteration for ∇²p = ρ/dt · ∇·u)
//=============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void PressureSolveCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);

	if (any(Coord >= GridSize))
		return;

	// Boundary: zero pressure at edges
	if (Coord.x == 0 || Coord.x == GridSize - 1 || Coord.y == 0 || Coord.y == GridSize - 1)
	{
		OutPressureField[Coord] = 0.0;
		return;
	}

	float pLeft  = LoadPressure(Coord + int2(-1, 0));
	float pRight = LoadPressure(Coord + int2(1, 0));
	float pUp    = LoadPressure(Coord + int2(0, 1));
	float pDown  = LoadPressure(Coord + int2(0, -1));

	float Div = DivergenceField.Load(int3(Coord, 0)).x;

	float NewPressure = 0.25 * (pLeft + pRight + pUp + pDown - CellSize * CellSize * Div);

	OutPressureField[Coord] = NewPressure;
}

//=============================================================================
// Step 5: Projection (subtract pressure gradient to enforce ∇·u = 0)
//=============================================================================
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ProjectionCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);

	if (any(Coord >= GridSize))
		return;

	float2 Vel = LoadVelocity(Coord);

	// Pressure gradient
	float pRight = LoadPressure(Coord + int2(1, 0));
	float pLeft  = LoadPressure(Coord + int2(-1, 0));
	float pUp    = LoadPressure(Coord + int2(0, 1));
	float pDown  = LoadPressure(Coord + int2(0, -1));

	float2 PressureGrad = float2(pRight - pLeft, pDown - pUp) / (2.0 * CellSize);
	Vel -= PressureGrad;

	// Boundary: zero velocity at edges
	if (Coord.x == 0 || Coord.x == GridSize - 1 || Coord.y == 0 || Coord.y == GridSize - 1)
	{
		Vel = float2(0, 0);
	}

	// Stability clamp
	Vel = clamp(Vel, -1000.0, 1000.0);

	OutVelocityField[Coord] = Vel;
}

//=============================================================================
// Vorticity Confinement (GPU Gems method)
//   Step A: Compute scalar vorticity  ω = ∂v/∂x - ∂u/∂y
//   Step B: Compute confinement force  f = ε·h·(N × ω̂)
//           where N = normalize(∇|ω|), ω̂ = (0,0,ω)
//=============================================================================

// Load vorticity with boundary clamping
float LoadVorticity(int2 Coord)
{
	Coord = clamp(Coord, int2(0, 0), int2(GridSize - 1, GridSize - 1));
	return VorticityField.Load(int3(Coord, 0)).x;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ComputeVorticityCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);

	if (any(Coord >= GridSize))
		return;

	// Central differences for curl: ω = ∂v/∂x - ∂u/∂y
	float2 vL = LoadVelocity(Coord + int2(-1, 0));
	float2 vR = LoadVelocity(Coord + int2( 1, 0));
	float2 vD = LoadVelocity(Coord + int2( 0,-1));
	float2 vU = LoadVelocity(Coord + int2( 0, 1));

	float Omega = (vR.y - vL.y - vD.x + vU.x) / (2.0 * CellSize);

	OutVorticityField[Coord] = Omega;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void VorticityConfinementCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Coord = int2(DispatchThreadId.xy);

	if (any(Coord >= GridSize))
		return;

	float2 Vel = LoadVelocity(Coord);

	// Boundary: skip edges
	if (Coord.x == 0 || Coord.x == GridSize - 1 || Coord.y == 0 || Coord.y == GridSize - 1)
	{
		OutVelocityField[Coord] = Vel;
		return;
	}

	// Sample vorticity at neighbors
	float omegaL = LoadVorticity(Coord + int2(-1, 0));
	float omegaR = LoadVorticity(Coord + int2( 1, 0));
	float omegaD = LoadVorticity(Coord + int2( 0,-1));
	float omegaU = LoadVorticity(Coord + int2( 0, 1));
	float omegaC = LoadVorticity(Coord);

	// η = ∇|ω|  (gradient of vorticity magnitude)
	float2 Eta = float2(abs(omegaR) - abs(omegaL), abs(omegaU) - abs(omegaD)) / (2.0 * CellSize);

	// N = normalize(η)
	float EtaLen = length(Eta);
	float2 N = (EtaLen > 1e-5) ? (Eta / EtaLen) : float2(0, 0);

	// Confinement force: f = ε · h · (N × ω̂)
	// In 2D with ω̂ = (0,0,ω): cross(N, ω̂) = (N.y·ω, -N.x·ω)
	float2 ConfinementForce = VorticityEpsilon * CellSize * float2(N.y, -N.x) * omegaC;

	Vel += ConfinementForce * DeltaTime;

	OutVelocityField[Coord] = Vel;
}
